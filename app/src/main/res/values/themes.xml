<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Enforce Light theme to guarantee visible fields on all devices -->
    <style name="Theme.LostAndFound" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_card</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/bg_screen</item>

        <!-- Text & Input Colors: Guaranteed high contrast -->
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="editTextColor">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/surface_card</item>

        <!-- Disable OEM / system forced dark mode color inversion -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Material Card Styling -->
        <item name="materialCardViewStyle">@style/Widget.LostAndFound.CardView</item>

        <!-- Default TextInputLayout Styling -->
        <item name="textInputStyle">@style/Widget.LostAndFound.TextInputLayout</item>
    </style>

    <style name="Widget.LostAndFound.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
    </style>

    <!-- Outlined TextInputLayout with crisp visible borders and high contrast labels -->
    <style name="Widget.LostAndFound.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/box_stroke_selector</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/surface_card</item>
    </style>

    <!-- Splash Theme to avoid blank screen during cold boot -->
    <style name="Theme.LostAndFound.Splash" parent="Theme.LostAndFound">
        <item name="android:windowBackground">@color/primary_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Aliases for backwards compatibility -->
    <style name="Theme.CampusFind" parent="Theme.LostAndFound" />
    <style name="Theme.CampusFind.Splash" parent="Theme.LostAndFound.Splash" />
    <style name="Widget.CampusFind.CardView" parent="Widget.LostAndFound.CardView" />
</resources>
